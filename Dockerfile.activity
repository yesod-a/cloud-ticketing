FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -q -pl services/activity-service -am clean package -DskipTests
FROM eclipse-temurin:21-jre
COPY --from=build /workspace/services/activity-service/target/activity-service-0.1.0-SNAPSHOT.jar /app.jar
ENTRYPOINT ["java","-jar","/app.jar"]
